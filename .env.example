# =====================================================================================================================
# Mẫu cấu hình: copy thành file .env (cùng thư mục) rồi điền giá trị. File .env chứa bí mật, KHÔNG commit.
# docker-compose.yml nạp .env cho db, web, ai_worker. Đổi .env xong: docker compose up -d (hoặc restart web / ai_worker).
#
# Ký hiệu: [BẮT BUỘC] phải điền mới chạy được; [TUỲ CHỌN] dòng KEY=... đang có dấu # thì code dùng giá trị mặc định
# ghi trên dòng đó, muốn đổi thì bỏ dấu # đầu dòng. Chú thích luôn nằm ở dòng riêng phía trên (không viết sau giá trị).
# Key của dịch vụ ngoài (Google, Apple, mail, R2, Pixabay) để trống thì tính năng đó tắt, phần còn lại vẫn chạy;
# khi có key chỉ cần điền vào đây và khởi động lại, không phải sửa code.
# =====================================================================================================================


# --- Django ----------------------------------------------------------------------------------------------------------

# [BẮT BUỘC] True khi phát triển: hiện lỗi chi tiết, phục vụ file /upload/ (ảnh, audio lưu đĩa), bật /api/auth/dev-token/,
# mail quên mật khẩu in ra log thay vì gửi thật. Production: False.
DJANGO_DEBUG=True

# [BẮT BUỘC] Khoá ký JWT, session, mã đặt lại mật khẩu. Đổi khoá = mọi người bị đăng xuất.
# Tạo: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# [BẮT BUỘC] Tên miền / IP được phép gọi API, cách nhau dấu phẩy. Test app trên điện thoại thật: thêm IP LAN của máy
# chạy server (vd 192.168.1.10), app gọi http://192.168.1.10:8000/api/...
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# --- Postgres (container db dùng để tạo DB lần đầu, Django dùng để kết nối) --------------------------------------------

# [BẮT BUỘC] tên database
POSTGRES_DB=flashwise
# [BẮT BUỘC] user database
POSTGRES_USER=postgres
# [BẮT BUỘC] mật khẩu database (đặt bất kỳ, chỉ dùng nội bộ)
POSTGRES_PASSWORD=
# tên service trong docker-compose; chạy Django ngoài Docker thì localhost + cổng 5433
POSTGRES_HOST=db
# cổng bên trong mạng Docker (ra ngoài máy là 5433)
POSTGRES_PORT=5432


# --- pgAdmin (giao diện xem DB ở http://localhost:5050, không bắt buộc dùng) ------------------------------------------

# email đăng nhập pgAdmin
PGADMIN_EMAIL=admin@admin.com
# [BẮT BUỘC nếu chạy service pgadmin] mật khẩu đăng nhập pgAdmin
PGADMIN_PASSWORD=


# --- Redis ------------------------------------------------------------------------------------------------------------
# Hàng đợi việc AI (db 0) + cache từ / bộ đếm giới hạn (db 1). Trong Docker không cần đổi.
# REDIS_HOST=redis
# REDIS_PORT=6379


# --- AI tạo từ (tra từ mới: Claude viết nội dung, Gemini dịch + metadata) ---------------------------------------------

# [BẮT BUỘC để tạo từ mới] Key Anthropic (console.anthropic.com > API Keys). Thiếu thì tra từ chưa có sẽ lỗi;
# từ đã có trong DB vẫn tra được.
ANTHROPIC_API_KEY=

# [BẮT BUỘC để tạo từ mới] Key Google AI Studio (aistudio.google.com > Get API key): dịch nghĩa sang ngôn ngữ người
# học, sinh metadata (từ đồng nghĩa, thẻ, từ khoá ảnh). Thiếu thì nghĩa không có bản dịch.
GEMINI_API_KEY=

# [TUỲ CHỌN] Key Pixabay (pixabay.com/api/docs, miễn phí, ~100 request / phút): tự lấy ảnh minh hoạ cho nghĩa mới.
# Để trống = không lấy ảnh.
PIXABAY_API_KEY=

# Model từng bước; nhiều model cách nhau dấu phẩy = model sau là dự phòng khi model trước lỗi.
# bước 1: viết các nghĩa của từ (stream từng nghĩa về app)
# AI_DRAFT_MODELS=claude-haiku-5-5
# bước 2: kiểm tra / sửa bản nháp trước khi lưu
# AI_REFINE_MODELS=claude-haiku-5-5
# độ kỹ của bước 2: low / medium / high (cao hơn = chậm, đắt hơn)
# AI_REFINE_EFFORT=low
# False: bỏ bước 2, lưu thẳng bản nháp (nhanh hơn, chất lượng kém hơn)
# AI_REFINE_ENABLED=True
# True: bước 2 được thêm nghĩa còn thiếu (chưa có ai kiểm lại nghĩa thêm)
# AI_REFINE_ALLOW_ADD=False
# số nghĩa tối đa bước 2 được thêm cho 1 từ khi bật dòng trên
# AI_REFINE_MAX_ADD=3
# model dịch + metadata
# GEMINI_API_MODEL=gemini-2.5-flash-lite
# ngôn ngữ luôn dịch sẵn cho mọi nghĩa (cộng ngôn ngữ của người đang tra)
# BASE_LANGUAGE=en

# Thời gian chờ (giây)
# tối đa cho 1 lần gọi bước 2, quá thì thử model kế tiếp / giữ bản nháp
# AI_REFINE_TIMEOUT=60
# tối đa cho 1 lần gọi Gemini, quá thì thử model kế tiếp
# AI_GEMINI_TIMEOUT=25
# tối đa chờ dịch + metadata trước khi lưu từ (phần thiếu dịch bù sau)
# AI_BACKGROUND_TIMEOUT=90
# từ "đang tạo" quá lâu (worker chết) thì lần tra sau tạo lại
# WORD_PROCESSING_STALE_SECONDS=600
# từ tạo lỗi: trong khoảng này tra lại trả 500, sau đó cho tạo lại
# WORD_ERROR_RETRY_SECONDS=60

# Khi AI báo hết hạn mức (429) / quá tải: chờ rồi thử lại, đồng thời worker tạm ngừng nhận từ mới
# số lần thử lại tối đa
# AI_RATE_LIMIT_RETRIES=4
# chờ 2s, 4s, 8s... (hoặc theo retry-after của nhà cung cấp)
# AI_BACKOFF_BASE_SECONDS=2
# trần thời gian chờ mỗi lần
# AI_BACKOFF_MAX_SECONDS=60

# Worker (service ai_worker, mặc định 2 bản): số việc chạy cùng lúc trên MỖI bản
# tạo từ mới. Khi chạy seed_words nâng lên 25-30
# WORD_SEMA_LIMIT=5
# tạo từ cho bộ tạo hàng loạt (bulk-create / add-words)
# COLLECTION_WORD_SEMA_LIMIT=5
# dịch bù ngôn ngữ còn thiếu
# TRANS_SEMA_LIMIT=20
# việc đang làm mà worker chết: trả lại hàng đợi tối đa bấy nhiêu lần
# JOB_MAX_REQUEUES=3

# Giới hạn tạo từ hàng loạt (tốn tiền AI)
# số từ tối đa mỗi lần bulk-create / add-words
# BULK_MAX_WORDS_PER_REQUEST=200
# số từ mới tối đa mỗi người / ngày
# BULK_WORDS_PER_DAY=500


# --- Đăng nhập tài khoản thật (thiếu key: cách đăng nhập đó trả 503 provider_not_configured, app ẩn nút) ------------
# App tự đăng nhập bằng SDK trên máy rồi gửi id token lên POST /api/auth/social-login/; server chỉ kiểm tra token.

# Google: Google Cloud Console > APIs & Services > Credentials > OAuth client ID. Tạo 1 client cho mỗi nền tảng
# (Web, iOS, Android); liệt kê TẤT CẢ client id, cách nhau dấu phẩy (id token phải mang 1 trong các id này).
# GOOGLE_CLIENT_IDS=xxx-web.apps.googleusercontent.com,xxx-ios.apps.googleusercontent.com,xxx-android.apps.googleusercontent.com

# Apple: bundle id của app iOS (Xcode / app.json ios.bundleIdentifier); thêm Service ID nếu có đăng nhập Apple trên web.
# APPLE_CLIENT_IDS=com.flashwise.app

# Apple (tuỳ chọn nhưng Apple yêu cầu khi app cho xoá tài khoản): thu hồi quyền "Sign in with Apple" lúc user xoá
# tài khoản. developer.apple.com > Certificates, IDs & Profiles > Keys > tạo key bật "Sign in with Apple", tải file .p8.
# Thiếu 3 key này vẫn đăng nhập Apple được, chỉ bỏ bước thu hồi.
# Team ID (góc trên bên phải trang developer)
# APPLE_TEAM_ID=ABCDE12345
# Key ID của key vừa tạo
# APPLE_KEY_ID=XYZ987WVU6
# nội dung file .p8, xuống dòng viết \n
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----


# --- Gửi mail (mã 6 số đặt lại mật khẩu) ------------------------------------------------------------------------------
# Không có EMAIL_HOST: DJANGO_DEBUG=True thì mail in ra log của web (docker compose logs web), False thì quên mật khẩu
# trả 503 email_not_configured. Gmail: bật xác minh 2 bước rồi tạo "App password" làm EMAIL_HOST_PASSWORD.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# tên + địa chỉ người gửi
# DEFAULT_FROM_EMAIL=Flashwise <no-reply@flashwise.vn>
# thời gian sống của mã
# PASSWORD_RESET_CODE_MINUTES=15


# --- Lưu file ảnh / audio (Cloudflare R2) -----------------------------------------------------------------------------
# Đủ cả 5 key R2_* thì file lưu lên R2, thiếu 1 key thì lưu thư mục upload/ trên máy chủ.
# DB chỉ lưu khoá file (vd media/<user>/<id>.webp); app ghép với media_base_url trong GET /api/app-config/.
# Chuyển từ đĩa sang R2: chép thư mục upload/ lên bucket (giữ nguyên đường dẫn) rồi điền 5 key, dữ liệu DB không đổi.
# Lấy key: Cloudflare dashboard > R2 > tạo bucket; "Manage R2 API Tokens" > tạo token quyền Object Read & Write.
# Account ID (trang tổng quan R2)
# R2_ACCOUNT_ID=
# Access Key ID của API token
# R2_ACCESS_KEY_ID=
# Secret Access Key của API token (chỉ hiện 1 lần lúc tạo)
# R2_SECRET_ACCESS_KEY=
# tên bucket
# R2_BUCKET=flashwise-media
# địa chỉ công khai của bucket: bật r2.dev hoặc gắn domain riêng (Settings > Public access)
# R2_PUBLIC_URL=https://media.flashwise.vn

# Chưa có R2: địa chỉ app dùng để tải file trong thư mục upload/ (Django chỉ phục vụ khi DJANGO_DEBUG=True).
# Test trên điện thoại thật phải là IP LAN, không dùng được localhost.
# MEDIA_PUBLIC_URL=http://localhost:8000/upload/

# Giới hạn file user tải lên (POST /api/media/)
# ảnh tối đa 5MB (trước khi nén)
# MEDIA_IMAGE_MAX_BYTES=5242880
# audio tối đa 2MB
# MEDIA_AUDIO_MAX_BYTES=2097152
# ảnh được thu nhỏ để cạnh dài nhất không quá số này (px)
# MEDIA_IMAGE_MAX_SIDE=1280
# số file mỗi người / ngày
# MEDIA_UPLOADS_PER_DAY=50


# --- Phiên đăng nhập & giới hạn request -------------------------------------------------------------------------------
# access token sống bao lâu (app tự gọi /api/refresh-token khi hết)
# JWT_ACCESS_MINUTES=60
# refresh token sống bao lâu (không mở app quá hạn này thì đăng nhập lại)
# JWT_REFRESH_DAYS=60
# request / IP chưa đăng nhập
# THROTTLE_ANON=60/minute
# request / user đã đăng nhập
# THROTTLE_USER=300/minute
# số lần tra từ MỚI (gọi AI) / người
# THROTTLE_WORD_GENERATE=60/hour
# đăng nhập / đăng ký / quên mật khẩu / IP (chống dò mật khẩu)
# THROTTLE_AUTH=20/minute
# tải toàn bộ dữ liệu cá nhân / người
# THROTTLE_EXPORT=5/day
# gửi report / góp ý / người
# THROTTLE_FEEDBACK=20/day


# --- Phiên bản app (GET /api/app-config/) -----------------------------------------------------------------------------
# app có số phiên bản nhỏ hơn thì bắt buộc cập nhật
# APP_MIN_VERSION=1
# phiên bản mới nhất (app nhắc cập nhật, không bắt buộc)
# APP_LATEST_VERSION=1
