# Copy thành .env rồi điền giá trị thật. File .env không được commit.

# --- Django ---
DJANGO_DEBUG=True
# Tạo key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Các host được phép gọi API, cách nhau bởi dấu phẩy (IP máy chạy server trong mạng LAN để app trên điện thoại gọi được)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres (dùng chung cho container db và Django) ---
POSTGRES_DB=flashwise
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- pgAdmin ---
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=

# --- AI / ảnh ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PIXABAY_API_KEY=

# --- Tạo từ bằng AI: draft + refine dùng Claude, dịch + metadata dùng Gemini; mọi bước tắt thinking (không bắt buộc) ---
# AI_DRAFT_MODELS=claude-haiku-5-5  # nhiều model cách nhau dấu phẩy = thử lần lượt khi lỗi
# AI_REFINE_MODELS=claude-haiku-5-5
# AI_REFINE_EFFORT=low              # low / medium / high
# GEMINI_API_MODEL=gemini-2.5-flash-lite,gemini-2.5-flash-lite  # dịch + metadata
# AI_REFINE_ENABLED=True            # False: bỏ bước refine, lưu thẳng draft (quality_status=draft)
# AI_REFINE_TIMEOUT=60              # giây cho mỗi model
# WORD_PROCESSING_STALE_SECONDS=600 # từ PROCESSING quá lâu (worker chết) thì tạo lại
# BULK_MAX_WORDS_PER_REQUEST=200
# BULK_WORDS_PER_DAY=500          # từ mới / người dùng / ngày khi tạo bộ từ hàng loạt
# REDIS_HOST=redis

# --- Đăng nhập tài khoản thật (không bắt buộc: thiếu key thì cách đăng nhập đó trả 503 provider_not_configured) ---
# GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com  # client id web / iOS / Android
# APPLE_CLIENT_IDS=com.flashwise.app       # bundle id (thêm service id nếu đăng nhập Apple trên web)
# APPLE_TEAM_ID=                           # 3 key dưới: thu hồi token Apple khi xoá tài khoản (Apple yêu cầu)
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----
# Gửi mã đặt lại mật khẩu; không có EMAIL_HOST thì DEBUG in mail ra log, production trả 503
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Flashwise <no-reply@flashwise.vn>

# --- Token & giới hạn request (không bắt buộc) ---
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=60
# THROTTLE_ANON=60/minute
# THROTTLE_USER=300/minute
# THROTTLE_WORD_GENERATE=60/hour
# THROTTLE_AUTH=20/minute
# THROTTLE_EXPORT=5/day
